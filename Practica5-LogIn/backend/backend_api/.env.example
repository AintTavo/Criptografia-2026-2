# Copia este archivo a .env y rellena los valores reales.
# NO subas el .env real al repositorio.

# URL pública del frontend (sin slash final). Usada en los enlaces de los correos.
APP_URL=http://localhost:5500

# Puerto de la API
PORT=3000

# Secreto para firmar los JWT de sesión. Genera uno con: openssl rand -hex 32
JWT_SECRET=cambia_esto_por_un_hex_de_32_bytes

# Base de datos SQLite
DATABASE_FILE=sqlite.db
SQL_FILE_PATH=../sql/db.sql

# Servidor de correo (Resend vía SMTP).
# Con Resend: SMTP_USER es literalmente "resend" (username de auth SMTP)
# y SMTP_PASS es tu API key (re_...).
# SMTP_FROM es la dirección remitente del header From (debe estar en un
# dominio verificado en Resend). Si se omite, se usa SMTP_USER, lo que
# producirá un From inválido cuando SMTP_USER=resend.
SMTP_SERVER=smtp.resend.com
SMTP_USER=resend
SMTP_PASS=re_tu_api_key_aqui
SMTP_FROM=no-reply@tu-dominio-verificado.com
